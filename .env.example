# CivicLens AI — Environment Configuration

# Database: MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=civiclens

# Security & Sessions
JWT_SECRET=your_super_strong_jwt_secret_min_32_characters
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=*

# Google GenAI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Cloudinary Cloud Storage (falls back to local disk storage in /uploads)
CLOUDINARY_URL=

# Optional: SMTP Server for Password Reset Emails (falls back to demoOtp when empty)
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CivicLens AI <no-reply@civiclens.gov>

# Optional Frontend API Base URL (used when frontend is deployed on Vercel separately from Render)
VITE_API_BASE_URL=